# сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
STREEMCAM_SECRET=
# ключ внутреннего API go2rtc → streemcam, сгенерировать так же, как секрет
STREEMCAM_INTERNAL_KEY=
# камеры Imou: ключи приложения с open.imoulife.com
IMOU_APP_ID=
IMOU_APP_SECRET=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
# публикация наружу: cloudflared (туннель) или caddy (HTTPS на VPS с белым IP)
COMPOSE_PROFILES=cloudflared
CLOUDFLARE_TUNNEL_TOKEN=
# для caddy: домен, A-запись которого указывает на сервер
STREEMCAM_DOMAIN=
# WireGuard (дома -> сервер): добавьте wireguard в COMPOSE_PROFILES, например COMPOSE_PROFILES=caddy,wireguard
# домашняя сеть каждого дома (подсети не должны совпадать)
WG_LAN_DOM1=
WG_LAN_DOM2=
WG_LAN_DOM3=
# белый IP или домен сервера (по умолчанию определяется сам)
WG_SERVER_URL=
# Камеры Imou через P2P (как приложение Imou Life): добавьте p2p в COMPOSE_PROFILES, например caddy,p2p
# СЕРИЙНИК:ПОРТ через пробел; порт — любой свободный, в config.yaml это host: dhp2p, port: ПОРТ
DHP2P_CAMERAS=
DHP2P_RELAY=0
# пароль камеры для RTSP — safety code с наклейки (по одной переменной на камеру)
IMOU_CAM1_PASSWORD=
