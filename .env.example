# сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
STREEMCAM_SECRET=
# ключ внутреннего API go2rtc → streemcam, сгенерировать так же, как секрет
STREEMCAM_INTERNAL_KEY=
# камеры Imou: ключи приложения с open.imoulife.com
IMOU_APP_ID=
IMOU_APP_SECRET=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
# публикация наружу: cloudflared (туннель) или caddy (HTTPS на VPS с белым IP)
COMPOSE_PROFILES=cloudflared
CLOUDFLARE_TUNNEL_TOKEN=
# для caddy: домен, A-запись которого указывает на сервер
STREEMCAM_DOMAIN=
