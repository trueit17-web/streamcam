+/// Debug line without addresses or payload, enabled by DHP2P_DEBUG=1 (prefix "DBG ").
+/// Only the first 300 lines per process, so a video stream does not flood the log.
+pub fn dbg_log(msg: &str) {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    static COUNT: AtomicUsize = AtomicUsize::new(0);
+    if std::env::var("DHP2P_DEBUG").map(|v| v == "1").unwrap_or(false)
+        && COUNT.fetch_add(1, Ordering::Relaxed) < 300
+    {
+        println!("DBG {}", msg);
+    }
+}
