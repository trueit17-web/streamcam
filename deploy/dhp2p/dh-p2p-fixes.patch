+    /// Like recv, but accepts a packet with data only when it continues the stream exactly
+    /// (packet.sent == bytes received so far). Duplicates (retransmits) and packets after a gap
+    /// return None and do not move the counters, so the next ACK tells the device what is missing.
+    pub fn recv_in_order(&mut self, packet: PTCPPacket) -> Option<PTCPPacket> {
+        let len = packet.body.len() as u32;
+        if len > 0 && packet.sent != self.recv {
+            dbg_log(&format!(
+                "drop sent={} expected={} len={}",
+                packet.sent, self.recv, len
+            ));
+            return None;
+        }
+        self.recv += len;
+        self.rmid = packet.lmid;
+        Some(packet)
+    }
